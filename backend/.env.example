# Google AI Studio Gemini Vision Key (free tier without credit card / billing)
# Create free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# Groq Cloud API Key (powers /ai-parse, /voice Whisper, AND /ocr Vision fallback — free without billing card)
# Create free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VOICE_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# USDA FoodData Central API Key (free without billing card)
# Create free key at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Optional free OCR fallback (https://ocr.space/ocrapi/freekey — 25k/mo free, no credit card)
OCR_SPACE_API_KEY=
