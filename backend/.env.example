# Copy this file to .env inside /rescale/backend (or add these in Render -> Environment)

# 1. Groq API Key (powers /ai-parse and /voice fallback)
# Get free at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional model overrides (defaults shown; replaces decommissioned llama-3.3-70b-versatile)
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VOICE_MODEL=whisper-large-v3-turbo

# 2. USDA FoodData Central API Key (powers /nutrition — 1,000 req/hr free)
# Get free at: https://fdc.nal.usda.gov/api-key-signup/
USDA_API_KEY=your_usda_data_gov_key_here

# 3. Optional: Google Cloud Vision API Key (fallback when local Tesseract OCR cannot read handwriting)
# Console: https://console.cloud.google.com/apis/credentials (enable "Cloud Vision API")
GOOGLE_VISION_API_KEY=
